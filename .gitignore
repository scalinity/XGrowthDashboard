# Secrets — NEVER commit
.env

# P9R-18: the active launchd plist holds XAI_API_KEY inline (launchd
# doesn't inherit the dashboard's .env, so the plist needs the key
# embedded). The CHECKED-IN copy is the .example variant with the
# REPLACE_WITH_… placeholder; the operator-edited copy (real key
# pasted in) is gitignored so a stray `git add launchd/` never ships
# the live key to public history.
launchd/com.scalinity.xgrowth.grok-sweep.plist

# Local user data (private to this single-user tool; never committed)
# Per §18 (privacy and security notes), data/ holds the user's private
# SQLite DB, exports, and backups. Block contents but keep the directory
# scaffolding via .gitkeep placeholders so the layout survives a clean clone.
data/*.db
data/*.db-wal
data/*.db-shm
data/backups/*
!data/backups/.gitkeep
data/exports/*
!data/exports/.gitkeep

# Python
__pycache__/
*.pyc
*.pyo

# Virtual env
.venv/

# Tooling caches
.pytest_cache/
.ruff_cache/

# Browser-automation scratch (Playwright MCP snapshots, console logs,
# ad-hoc screenshots taken during visual verification). Not part of the
# committed artifact set per CLAUDE.md "Public-Safe Commits".
.playwright-mcp/
phase*.png

# OS
.DS_Store
Thumbs.db
