# Dev-only sidecar overrides for the browser screenshot-diff loop (§31, Step 0).
#
# Copy this file to `.env.development.local` (gitignored via `*.local`) and run:
#
#   1. uv run python -m scripts.dev_sidecar        # fixed-port sidecar (8765)
#   2. pnpm -C desktop dev                          # Vite reads the vars below
#
# Then open the Vite URL in a browser to screenshot-diff against the Streamlit
# pages (`uv run streamlit run app/main.py`). In a real Tauri launch these are
# UNSET — the shell supplies a random port + per-launch token instead.

VITE_SIDECAR_URL=http://127.0.0.1:8765
VITE_SIDECAR_TOKEN=dev-token
