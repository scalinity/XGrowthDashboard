# Anthropic (used from Phase 5.5)
ANTHROPIC_API_KEY=sk-ant-...

# Voyage AI — embedding provider for the §28.13 repetition guard
# (Phase 5.8). Default model: voyage-3-lite. Get a key at
# https://docs.voyageai.com/. Substitute OpenAI by editing
# DEFAULT_PROVIDER in app/agent/embeddings.py and setting
# OPENAI_API_KEY instead. Without either key the repetition guard
# returns None at save time and the draft proceeds — never blocks.
VOYAGE_API_KEY=
# OPENAI_API_KEY=

# X API (Phase 6 only; not required for MVP)
X_API_BEARER_TOKEN=
X_API_OAUTH_CONSUMER_KEY=
X_API_OAUTH_CONSUMER_SECRET=
X_API_OAUTH_ACCESS_TOKEN=
X_API_OAUTH_ACCESS_TOKEN_SECRET=

# xAI Grok API (Phase 9; required only if grok_api_enabled=TRUE in Settings).
# Used by app/grok_client.py to call POST /v1/chat/completions with
# search_parameters.sources=[{"type": "x"}] for X-firehose discovery of
# reply candidates per §29.12. Every candidate verifies against the X
# API before scoring (§29.2 invariant) — Grok never bypasses verification.
# Combined Anthropic + xAI spend is capped by
# combined_ai_monthly_cost_ceiling_usd (§28.6, default $30/month).
# Get a key at https://console.x.ai/.
XAI_API_KEY=

# Data collection mode (manual is the MVP default, see §17)
DATA_COLLECTION_MODE=manual

# Database
DASHBOARD_DB_PATH=./data/dashboard.db
